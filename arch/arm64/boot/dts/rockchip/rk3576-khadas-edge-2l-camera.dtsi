&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_imx415_0: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx415_out0>;
				data-lanes = <1 2 3 4>;
			};
			mipi_in_imx585_0: endpoint@2 {
				reg = <2>;
				remote-endpoint = <&imx585_out0>;
				data-lanes = <1 2 3 4>;
			};

			mipi_in_imx678_0: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&imx678_out0>;
				data-lanes = <1 2 3 4>;
			};

			mipi_in_os08a10_0: endpoint@4 {
				reg = <4>;
				remote-endpoint = <&os08a10_out0>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy1_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi1_csi2_input>;
			};
		};
	};
};

&csi2_dphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_imx415_1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx415_out1>;
				data-lanes = <1 2 3 4>;
			};
			mipi_in_imx585_1: endpoint@2 {
				reg = <2>;
				remote-endpoint = <&imx585_out1>;
				data-lanes = <1 2 3 4>;
			};

			mipi_in_imx678_1: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&imx678_out1>;
				data-lanes = <1 2 3 4>;
			};

			mipi_in_os08a10_1: endpoint@4 {
				reg = <4>;
				remote-endpoint = <&os08a10_out1>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy3_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi3_csi2_input>;
			};
		};
	};
};

&i2c7 {
	status = "okay";
	pinctrl-0 = <&i2c7m1_xfer>;

	os08a10_0: os08a10-0@36 {
		compatible = "ovti,os08a10";
		status = "okay";
		reg = <0x36>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M2>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
		port {
			os08a10_out0: endpoint {
				remote-endpoint = <&mipi_in_os08a10_0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	dw9714_0: dw9714-0@c {
		compatible = "dongwoon,dw9714";
		status = "okay";
		reg = <0x0c>;
		pinctrl-names = "focus_gpio_0";
		pinctrl-0 = <&focus_gpio_0>;
		focus-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
		rockchip,vcm-start-current = <0>;
		rockchip,vcm-rated-current = <65>;
		rockchip,vcm-step-mode = <4>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
	};

	imx415_0: imx415-0@1a {
		compatible = "sony,imx415";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M2>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio1 RK_PC1 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-OT2022-PX1";
		rockchip,camera-module-lens-name = "IR0147-50IRC-8M-F20";
		lens-focus = <&dw9714_0>;
		port {
			imx415_out0: endpoint {
				remote-endpoint = <&mipi_in_imx415_0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	imx585_0: imx585-0@1a {
		compatible = "sony,imx585";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M2>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-IMX585-PX1";
		rockchip,camera-module-lens-name = "FH34SRJ-30SCK0";
		port {
			imx585_out0: endpoint {
				remote-endpoint = <&mipi_in_imx585_0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	imx678_0: imx678-0@1a {
		compatible = "sony,imx678";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M2>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "FH34SRJ-30S";
		rockchip,camera-module-lens-name = "YG4118";
		port {
			imx678_out0: endpoint {
				remote-endpoint = <&mipi_in_imx678_0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&i2c6 {
	status = "okay";
	pinctrl-0 = <&i2c6m2_xfer>;

	os08a10_1: os08a10-1@36 {
		compatible = "ovti,os08a10";
		status = "okay";
		reg = <0x36>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M1>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1m0_clk1>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB2 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
		port {
			os08a10_out1: endpoint {
				remote-endpoint = <&mipi_in_os08a10_1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	dw9714_1: dw9714-1@c {
		compatible = "dongwoon,dw9714";
		status = "okay";
		reg = <0x0c>;
		pinctrl-names = "focus_gpio_1";
		pinctrl-0 = <&focus_gpio_1>;
		focus-gpios = <&gpio2 RK_PB2 GPIO_ACTIVE_HIGH>;
		rockchip,vcm-start-current = <0>;
		rockchip,vcm-rated-current = <65>;
		rockchip,vcm-step-mode = <4>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
	};

	imx415_1: imx415-1@1a {
		compatible = "sony,imx415";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M1>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1m0_clk1>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "CMK-OT2022-PX1";
		rockchip,camera-module-lens-name = "IR0147-50IRC-8M-F20";
		lens-focus = <&dw9714_1>;
		port {
			imx415_out1: endpoint {
				remote-endpoint = <&mipi_in_imx415_1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};


	imx585_1: imx585-1@1a {
		compatible = "sony,imx585";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M1>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1m0_clk1>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB2 GPIO_ACTIVE_LOW>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "CMK-IMX585-PX1";
		rockchip,camera-module-lens-name = "FH34SRJ-30SCK0";
		port {
			imx585_out1: endpoint {
				remote-endpoint = <&mipi_in_imx585_1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	imx678_1: imx678-1@1a {
		compatible = "sony,imx678";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMERAOUT_M1>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1m0_clk1>;
		power-domains = <&power RK3576_PD_VI>;
		reset-gpios = <&gpio2 RK_PB2 GPIO_ACTIVE_LOW>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "FH34SRJ-30S";
		rockchip,camera-module-lens-name = "YG4118";
		port {
			imx678_out1: endpoint {
				remote-endpoint = <&mipi_in_imx678_1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&mipi1_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi1_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy1_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi1_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in1>;
			};
		};
	};
};

&mipi3_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi3_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy3_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi3_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in3>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds1 {
	status = "okay";

	port {
		cif_mipi_in1: endpoint {
			remote-endpoint = <&mipi1_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds1_sditf {
	status = "okay";

	port {
		mipi1_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkcif_mipi_lvds3 {
