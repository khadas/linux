		};
	};
};

&rkcif_mmu {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi1_lvds_sditf>;
		};
	};
};

&rkisp_vir1 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir1: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi3_lvds_sditf>;
		};
	};
};

&rkvpss {
	status = "okay";
};

&rkvpss_mmu {
	status = "okay";
};

&rkvpss_vir0 {
	status = "okay";
};

&rkvpss_vir1 {
	status = "okay";
};

&rkvpss_vir2 {
	status = "okay";
};

&rkvpss_vir3 {
	status = "okay";
};

&pinctrl {
	cam {
		focus_gpio_0: focus-gpio-0 {
			rockchip,pins =
				<2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		focus_gpio_1: focus-gpio-1 {
			rockchip,pins =
				<2 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};